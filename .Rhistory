# read in the data
df <- read.csv('ASNR_2025_Abstract_data.csv',
header = TRUE,
stringsAsFactors = TRUE)
library(tidyverse)
library(dplyr)
library(ggplot2)
library(robustbase)
library(robust)
head(df)
# clean it up a little just by removing the X column
df <- select(df, -X)
hist(df$Average_Gait_Speed)
shapiro.test(df$Average_Gait_Speed)
lm = lmRob(Average_Gait_Speed ~ Ethnicity * X01_AB_FBB_AB_pos + Age*ID_Gender+IMH_HighBP + IMH_Diabetes + Ethnicity*IMH_Diabetes, data=df)
summary(lm)
model_df <- tidy(lm, conf.int=TRUE)
library(tidyverse)
library(broom)
library(dplyr)
library(ggplot2)
library(robustbase)
library(robust)
model_df <- tidy(lm, conf.int=TRUE)
model_df$term <- reorder(model_df$term,model_df$estimate)
# Add a column for whether or not the variable is significant or not significant
model_df$sig <- ifelse(model_df$p.value < 0.05, "Significant", "Not Significant")
# filter out the intercept
model_df_filt <- model_df %>% filter(term != "(Intercept)")
# Plot
lm.coefficient.plot <- ggplot(model_df_filt, aes(x=estimate, y=term, color = sig)) +
geom_point() +
geom_errorbarh(aes(xmin=conf.low,xmax=conf.high), height = 0.2) +
scale_y_discrete(labels = c(
"(Intercept)" = "(Intercept)",
"IMH_Diabetes" = "Diabetes",
"ID_Gender" = "Sex",
"IMH_HighBP" = "Hypertension",
"X01_AB_FBB_AB_pos" = "Amyloid Status",
"Age" = "Age",
"Age:ID_Gender" = "Age:Sex",
"EthnicityWhite:X01_AB_FBB_AB_pos" = "Ethnicity:Amyloid Status",
"EthnicityWhite:IMH_Diabetes" = "Ethnicity:Diabetes",
"EthnicityWhite" = "Ethnicity"
)) +
geom_vline(xintercept = 0, linetype = "dashed") +
scale_color_manual(values=c("Significant"="firebrick","Not Significant"= "gray40")) +
theme(
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.title.x = element_text(size = 12, face = "bold"),
axis.title.y = element_text(size = 12, face = "bold"),
axis.text.x = element_text(size = 10, face = "bold"),
axis.text.y = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 10, face = "bold"),
legend.position = "bottom"
) +
labs(
x = "Coefficient Estimate",
y = "Predictor",
color = "",
title = "Regression Coefficients with 95% Confidence Intervals"
)
# view your plot
lm.coefficient.plot
