data(diamonds)
?diamonds # Tells you more about the dataset
ggplot(diamonds, aes(x = cut, y = price)) +
geom_point() +
labs(
title = "Overplotting Without Jitter",
x = "Cut",
y = "Price"
)
ggplot(diamonds, aes(x = cut, y = price)) +
geom_jitter() +
labs(
title = "Price by Cut (with Jitter)",
x = "Cut",
y = "Price"
)
# You can even specify the width, transparency, and color within geom_jitter. Transparency can be changed with the alpha argument
ggplot(diamonds, aes(x = cut, y = price)) +
geom_jitter(width = 0.2, alpha = 0.3, color = "steelblue") +
labs(
title = "Price by Cut (with Jitter)",
x = "Cut",
y = "Price"
)
ggplot(diamonds, aes(x = carat, y = price, color = clarity)) +
geom_point() +
labs(
title = "Overplotting",
x = "Carat",
y = "Price"
)
ggplot(diamonds, aes(x = carat, y = price, color = clarity)) +
geom_point(alpha = 0.5, shape = ".") +
labs(
title = "No longer heavily overplotted",
x = "Carat",
y = "Price"
)
ggplot(mtcars, aes(x = mpg)) +
# add a histogram layer
geom_histogram()
